{%- comment -%}
  Short story, three chapters.
  • Wide screens (900px+): one large picture stays put on the left (sticky)
    while the chapters scroll past on the right; the picture cross-fades to
    the chapter in the middle of the screen and a thin rail shows which one
    it is (wango-extras.js, [data-story]). All pictures are stacked in the
    sticky frame and only opacity/scale change, so the swap is GPU-only.
  • Phones: every chapter carries its own picture above its copy and comes
    in with the shared scroll-scrubbed .w-reveal.
  A picture comes from `image_url` (a CDN link, e.g. a product photo), the
  image picker, or a packaged theme asset, in that order.
{%- endcomment -%}

{%- capture pics -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.image_url != blank -%}
      {%- assign u = block.settings.image_url | split: '?' | first -%}
      <img src="{{ u }}?width=1200" srcset="{{ u }}?width=700 700w, {{ u }}?width=1200 1200w, {{ u }}?width=1600 1600w"
           sizes="(min-width: 900px) 46vw, 100vw" alt="{{ block.settings.title | escape }}" loading="lazy" data-story-src="{{ forloop.index0 }}">
    {%- else -%}
      {%- capture one -%}{% render 'wango-image', image: block.settings.image, asset: block.settings.image_asset, alt: block.settings.title, loading: 'lazy', sizes: '(min-width: 900px) 46vw, 100vw' %}{%- endcapture -%}
      {{ one | replace: '<img', '<img data-story-src="__I__"' | replace: '__I__', forloop.index0 }}
    {%- endif -%}
    <!--split-->
  {%- endfor -%}
{%- endcapture -%}
{%- assign pic_list = pics | split: '<!--split-->' -%}

<section id="hikaye" class="w-story" data-story>
  <div class="w-story__grain" aria-hidden="true"></div>
  <div class="w-story__inner">
    <div class="w-story__stage" aria-hidden="true">
      <div class="w-story__frame">
        {%- for block in section.blocks -%}
          <figure class="w-story__pic{% if forloop.first %} is-on{% endif %}" data-story-pic>{{ pic_list[forloop.index0] }}</figure>
        {%- endfor -%}
      </div>
      <ol class="w-story__rail">
        {%- for block in section.blocks -%}<li{% if forloop.first %} class="is-on"{% endif %} data-story-dot><i></i></li>{%- endfor -%}
      </ol>
    </div>

    <div class="w-story__chapters">
      {%- for block in section.blocks -%}
        <article class="w-story__ch{% if forloop.first %} is-on{% endif %}" data-story-ch {{ block.shopify_attributes }}>
          <figure class="w-story__mpic w-reveal">{{ pic_list[forloop.index0] }}</figure>
          <div class="w-story__copy w-reveal">
            <span class="w-story__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="w-eyebrow">{{ block.settings.eyebrow }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
            {%- if block.settings.chips != blank -%}
              <ul class="w-story__chips">
                {%- assign chips = block.settings.chips | split: ',' -%}
                {%- for c in chips -%}<li>{{ c | strip }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

