{%- comment -%}Five periwinkle stars; `filled` (0–5) are solid.{%- endcomment -%}
{%- assign n = filled | default: 5 -%}
<span class="w-stars" aria-label="{{ n }} / 5">
  {%- for i in (1..5) -%}
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
      <path d="M6 1l1.5 3.2 3.5.45-2.6 2.4.7 3.45L6 8.9 2.9 10.5l.7-3.45L1 4.65l3.5-.45z"
            fill="{% if forloop.index <= n %}var(--w-accent){% else %}none{% endif %}"
            stroke="var(--w-accent)" stroke-width="0.9" stroke-linejoin="round"/>
    </svg>
  {%- endfor -%}
</span>
