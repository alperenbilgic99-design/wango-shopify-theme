{%- comment -%}Spec table on the warm paper ground — scroll relief between two black sections.{%- endcomment -%}
<section class="w-paper w-section">
  <div class="w-wrap">
    <div class="w-specs__grid">
      <div class="w-reveal">
        <span class="w-specs__tag">{{ section.settings.tag }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.body }}</p>
      </div>

      <div class="w-reveal" data-reveal-delay="0.1">
        <div class="w-bezel w-bezel--light">
          <dl class="w-specs__table">
            {%- for block in section.blocks -%}
              <div {{ block.shopify_attributes }}>
                <dt>{{ block.settings.key }}</dt>
                <dd>{{ block.settings.value }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ürün · teknik",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "tag", "default": "Teknik", "label": "Etiket" },
    { "type": "text", "id": "heading", "default": "Ne var, ne yok.", "label": "Başlık" },
    { "type": "textarea", "id": "body", "default": "Analog bir filtre: içinde elektronik yok, şarj yok. Kutudan çıkanlar ve neyden yapıldığı.", "label": "Metin" }
  ],
  "blocks": [
    { "type": "spec", "name": "Satır", "settings": [
      { "type": "text", "id": "key", "label": "Başlık" },
      { "type": "text", "id": "value", "label": "Değer" }
    ]}
  ],
  "presets": [{
    "name": "Ürün · teknik",
    "blocks": [
      {"type": "spec", "settings": {"key": "Tür", "value": "Akustik kanallı kulak tıkacı · analog"}},
      {"type": "spec", "settings": {"key": "Filtre", "value": "Basınçsız akustik kanal · sesi kesmez, kısar"}},
      {"type": "spec", "settings": {"key": "Gövde", "value": "Hipoalerjenik silikon, metal detay"}},
      {"type": "spec", "settings": {"key": "Uçlar", "value": "4 boy silikon uç · S, M, L, Double"}},
      {"type": "spec", "settings": {"key": "Bakım", "value": "Yıkanabilir, tekrar tekrar kullanılır"}},
      {"type": "spec", "settings": {"key": "Taşıma", "value": "Kutu ve kutuya entegre deri kayış"}},
      {"type": "spec", "settings": {"key": "Renkler", "value": "Obsidian Black · Tropical Indigo"}},
      {"type": "spec", "settings": {"key": "Şarj", "value": "Yok · elektronik parça yok"}}
    ]
  }]
}
{% endschema %}
