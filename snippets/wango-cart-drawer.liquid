{%- comment -%}
  Cart drawer: slides in from the right whenever something is added to the
  cart (any "Sepete ekle", the set card, the sticky buy bar, the two-colour
  offer) and when the header's cart pill is tapped. Lines, quantities and
  totals are drawn by wango-commerce.js from Shopify's own /cart.js, so they
  are always the real cart; "Ödemeye geç" goes to Shopify's checkout.

  The products listed below feed the "add the other colour" suggestion:
  whichever of them is not in the cart yet is offered with one tap.
  Not rendered on the cart page itself (that page already shows everything).
{%- endcomment -%}

{%- unless template.name == 'cart' -%}
  <div class="w-drawer" data-cart-drawer aria-hidden="true">
    <div class="w-drawer__scrim" data-drawer-close></div>
    <aside class="w-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="wango-drawer-title" tabindex="-1">
      <header class="w-drawer__head">
        <h2 id="wango-drawer-title">{{ 'sections.cart.title' | t }} <span data-drawer-count></span></h2>
        <button type="button" class="w-drawer__x" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </header>

      <p class="w-drawer__added" data-drawer-added hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
        {{ 'products.product.added' | t }}
      </p>

      <div class="w-drawer__body" data-lenis-prevent>
        <ul class="w-drawer__lines" data-drawer-lines></ul>
        <div class="w-drawer__empty" data-drawer-empty hidden>
          <p>{{ 'sections.cart.empty' | t }}</p>
          <a class="w-btn w-btn--solid" href="/pages/wango-setler#setler" data-drawer-close-link>{{ 'sections.cart.continue' | t }}</a>
        </div>
        <div class="w-drawer__upsell" data-drawer-upsell hidden></div>
      </div>

      <footer class="w-drawer__foot" data-drawer-foot>
        <div class="w-drawer__row"><span>{{ 'sections.cart.subtotal' | t }}</span><b data-drawer-subtotal></b></div>
        <div class="w-drawer__row"><span>{{ 'sections.cart.shipping' | t }}</span><span class="w-drawer__free">Ücretsiz</span></div>
        <a class="w-btn w-btn--solid w-btn--block" href="/checkout">{{ 'sections.cart.checkout' | t }}</a>
        <a class="w-drawer__view" href="{{ routes.cart_url }}">Sepeti görüntüle</a>
        <p class="w-drawer__trust">2 iş günü içinde kargoda · Ödeme Shopify'ın güvenli ödeme sayfasında</p>
      </footer>
    </aside>
  </div>

  <script type="application/json" data-drawer-products>
    [
      {%- for p in collections.all.products limit: 6 -%}
        {%- assign v = p.selected_or_first_available_variant -%}
        {
          "product_id": {{ p.id }},
          "variant_id": {{ v.id }},
          "title": {{ p.title | json }},
          "price": {{ v.price }},
          "image": {{ p.featured_media | image_url: width: 160 | json }},
          "available": {{ v.available }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
{%- endunless -%}
