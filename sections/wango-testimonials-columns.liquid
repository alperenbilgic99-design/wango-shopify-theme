{%- comment -%}
  Testimonials wall — a faithful port of testimonials-columns-1.tsx (React +
  motion). Three columns of cards drift upward in an endless loop behind a
  top-and-bottom fade.

  Differences from the React source, and why:
  · motion's `animate={{translateY:"-50%"}}` is one CSS keyframe here — no
    script, and it runs on the compositor. Each column prints its cards twice,
    so -50% lands exactly on the second copy and the seam never shows. The
    second copy is aria-hidden, so a screen reader reads each card once.
  · Blocks are split into three CONTIGUOUS groups, matching the source's
    slice(0,3) / slice(3,6) / slice(6,9) — not round-robin — so a column never
    repeats the card next to it.
  · Card, pill, heading and column metrics are the source's Tailwind values:
    p-10, rounded-3xl, border, shadow-lg shadow-primary/10, max-w-xs, gap-6,
    max-h-[740px], durations 15/19/17.

  This is content, not a review app: nothing here comes from verified orders.
  Replace the sample text in the theme editor with real customer words before
  presenting it as collected reviews.
{%- endcomment -%}

{%- liquid
  assign durations = '15,19,17' | split: ','
  assign total = section.blocks.size
  assign per_col = total | plus: 2 | divided_by: 3
  if per_col < 1
    assign per_col = 1
  endif
-%}

<section class="w-tcols-section {{ section.settings.ground }} w-section">
  <div class="w-wrap">
    <div class="w-tcols__head w-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <div class="w-tcols__pill">{{ section.settings.eyebrow }}</div>
      {%- endif -%}
      <h2 class="w-tcols__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="w-tcols__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="w-tcols">
      {%- for col in (0..2) -%}
        <div class="w-tcol w-tcol--{{ col }}" style="--w-tcol-dur: {{ durations[col] }}s">
          <div class="w-tcol__track">
            {%- for copy in (1..2) -%}
              <div class="w-tcol__copy"{% if copy == 2 %} aria-hidden="true"{% endif %}>
                {%- for block in section.blocks -%}
                  {%- assign slot = forloop.index0 | divided_by: per_col -%}
                  {%- if slot == col -%}
                    <figure class="w-tcard"{% if copy == 1 %} {{ block.shopify_attributes }}{% endif %}>
                      <blockquote class="w-tcard__text">{{ block.settings.text }}</blockquote>
                      <figcaption class="w-tcard__by">
                        {%- if block.settings.image != blank -%}
                          <img class="w-tcard__avatar"
                               src="{{ block.settings.image | image_url: width: 80, height: 80, crop: 'center' }}"
                               width="40" height="40" alt="{{ block.settings.name | escape }}" loading="lazy">
                        {%- else -%}
                          <span class="w-tcard__avatar w-tcard__avatar--initial" aria-hidden="true">
                            {{- block.settings.name | strip | slice: 0 | upcase -}}
                          </span>
                        {%- endif -%}
                        <span class="w-tcard__who">
                          <strong>{{ block.settings.name }}</strong>
                          {%- if block.settings.role != blank -%}<small>{{ block.settings.role }}</small>{%- endif -%}
                        </span>
                      </figcaption>
                    </figure>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Yorumlar · sütunlar",
  "max_blocks": 12,
  "settings": [
    { "type": "select", "id": "ground", "label": "Zemin", "default": "w-black", "options": [
      { "value": "w-black", "label": "Koyu" },
      { "value": "w-paper", "label": "Açık" }
    ]},
    { "type": "text", "id": "eyebrow", "default": "Yorumlar", "label": "Etiket" },
    { "type": "text", "id": "heading", "default": "Kullananlar ne diyor?", "label": "Başlık" },
    { "type": "textarea", "id": "subheading", "default": "wango taşıyanların kendi cümleleri.", "label": "Alt metin" }
  ],
  "blocks": [
    { "type": "testimonial", "name": "Yorum", "settings": [
      { "type": "textarea", "id": "text", "label": "Yorum" },
      { "type": "text", "id": "name", "label": "Ad" },
      { "type": "text", "id": "role", "label": "Alt satır (isteğe bağlı)" },
      { "type": "image_picker", "id": "image", "label": "Fotoğraf (isteğe bağlı)", "info": "Boşsa adın baş harfi gösterilir." }
    ]}
  ],
  "presets": [{
    "name": "Yorumlar · sütunlar",
    "blocks": [
      { "type": "testimonial", "settings": { "text": "Sekiz saat taktım, hiç acıtmadı. Kutusu o kadar küçük ki anahtarlığımda taşıyorum.", "name": "Deniz K.", "role": "Origin Obsidian Black" } },
      { "type": "testimonial", "settings": { "text": "Açık ofiste klavye sesi ve konuşmalar kayboluyor, müzik dinlemiyorum bile. Sadece sessizlik.", "name": "Elif A.", "role": "Origin Tropical Indigo" } },
      { "type": "testimonial", "settings": { "text": "Uçakta motor uğultusunu aldı, anons duyulmaya devam etti. Tam istediğim denge.", "name": "Mert Y.", "role": "Origin Obsidian Black" } },
      { "type": "testimonial", "settings": { "text": "Küpelerimle uyumlu duruyor. Kulaklık aldığımı değil, bir parça aldığımı hissettim.", "name": "Selin T.", "role": "Origin Tropical Indigo" } },
