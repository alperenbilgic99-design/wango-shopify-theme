    "reviews": {
      "type": "wango-testimonials-columns",
      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "text": "Sekiz saat taktım, hiç acıtmadı. Kutusu o kadar küçük ki anahtarlığımda taşıyorum.",
            "name": "Deniz K.",
            "role": "Origin Obsidian Black"
          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "text": "Açık ofiste klavye sesi ve konuşmalar kayboluyor, müzik dinlemiyorum bile. Sadece sessizlik.",
            "name": "Elif A.",
            "role": "Origin Tropical Indigo"
          }
        },
        "t3": {
          "type": "testimonial",
          "settings": {
            "text": "Uçakta motor uğultusunu aldı, anons duyulmaya devam etti. Tam istediğim denge.",
            "name": "Mert Y.",
            "role": "Origin Obsidian Black"
          }
        },
        "t4": {
          "type": "testimonial",
          "settings": {
            "text": "Küpelerimle uyumlu duruyor. Kulaklık aldığımı değil, bir parça aldığımı hissettim.",
            "name": "Selin T.",
            "role": "Origin Tropical Indigo"
          }
        },
        "t5": {
          "type": "testimonial",
          "settings": {
            "text": "Konserden çınlamayla çıkmamak yıllar sonra ilk. Müziğin tadı da kaçmadı.",
            "name": "Burak Ö.",
            "role": "Origin Obsidian Black"
          }
        },
        "t6": {
          "type": "testimonial",
          "settings": {
            "text": "Yan odadaki televizyon sesi bitti, uykuya dalma süresi yarıya indi.",
            "name": "Ayşe N.",
            "role": "Origin Tropical Indigo"
          }
        },
        "t7": {
          "type": "testimonial",
          "settings": {
            "text": "Metroda tam kapatıyor, ofiste hafif açık bırakıyorum. Kademe farkı gerçekten hissediliyor.",
            "name": "Can D.",
            "role": "Origin Obsidian Black"
          }
        },
        "t8": {
          "type": "testimonial",
          "settings": {
            "text": "Üç farklı uç geliyor, ortancası kulağıma oturdu. Koşarken bile yerinden oynamıyor.",
            "name": "Zeynep K.",
            "role": "Origin Tropical Indigo"
          }
        },
        "t9": {
          "type": "testimonial",
          "settings": {
            "text": "Kütüphanede kullanıyorum. Taktığımı kimse fark etmiyor, ben de kimseyi duymuyorum.",
            "name": "Emre S.",
            "role": "Origin Obsidian Black"
          }
        }
      },
