{%- comment -%}
  Box reveal: a Cycles render of the real die-cut (every face printed from the
  print file) scrubbed by scroll. The open is staged like the physical box:
  outer lid (the "hoş geldin" letter inside), inner flap with its window, then
  the insert, and the case lifts out. Each stage has one line of copy that
  arrives with it. Two renders (Tropical Indigo / Obsidian Black) share one
  scroll position; the swatches crossfade between them.
{%- endcomment -%}
{%- liquid
  if section.settings.video_url != blank
    assign video_src = section.settings.video_url
  else
    assign video_src = section.settings.video_asset | asset_url
  endif
  assign video_mobile = section.settings.video_asset_mobile | asset_url
  assign poster = section.settings.poster_asset | asset_url
  assign poster_end = section.settings.poster_end_asset | asset_url
  assign video_black = section.settings.video_asset_black | asset_url
  assign video_black_mobile = section.settings.video_asset_black_mobile | asset_url
  assign poster_black = section.settings.poster_asset_black | asset_url
  assign poster_end_black = section.settings.poster_end_asset_black | asset_url
-%}
<section class="w-bscroll w-paper" id="kesfet" data-bscroll
         style="--bs-scroll: {{ section.settings.scroll_length }}vh">
  <div class="w-bscroll__stage" data-bscroll-stage>
    <div class="w-bscroll__grid">
      <div class="w-bscroll__copy">
        <div class="w-bscroll__beat is-head" data-bscroll-beat data-in="0" data-out="0.25">
          {%- if section.settings.eyebrow != blank -%}<span class="w-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          <h2>
            {%- if section.settings.lead != blank -%}<span class="w-bscroll__lead">{{ section.settings.lead }}</span>{%- endif -%}
            <span class="w-bscroll__big">{{ section.settings.heading }}</span>
          </h2>
        </div>
        {%- for block in section.blocks -%}
          <div class="w-bscroll__beat" data-bscroll-beat data-in="{{ block.settings.start | divided_by: 100.0 }}" data-out="{{ block.settings.end | divided_by: 100.0 }}" {{ block.shopify_attributes }}>
            <span class="w-eyebrow">{{ block.settings.kicker }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </div>
        {%- endfor -%}
      </div>
      <div class="w-bscroll__media">
        <div class="w-bscroll__frame">
          <video class="w-bscroll__video is-on" data-bscroll-video data-variant="indigo"
                 data-src="{{ video_src }}" data-src-mobile="{{ video_mobile }}" data-poster-end="{{ poster_end }}"
                 muted playsinline preload="none" disablepictureinpicture tabindex="-1"
                 poster="{{ poster }}" aria-label="{{ section.settings.alt | escape }} (Tropical Indigo)"></video>
          <video class="w-bscroll__video" data-bscroll-video data-variant="black"
                 data-src="{{ video_black }}" data-src-mobile="{{ video_black_mobile }}" data-poster-end="{{ poster_end_black }}"
                 muted playsinline preload="none" disablepictureinpicture tabindex="-1"
                 poster="{{ poster_black }}" aria-label="{{ section.settings.alt | escape }} (Obsidian Black)"></video>
        </div>
        <div class="w-bscroll__swatches" role="radiogroup" aria-label="{{ section.settings.swatch_label | escape }}">
          <button type="button" role="radio" aria-checked="true" data-bscroll-swatch="indigo">
            <i style="--sw: #7E76BC"></i>Tropical Indigo
          </button>
          <button type="button" role="radio" aria-checked="false" data-bscroll-swatch="black">
            <i style="--sw: #1B1B1D"></i>Obsidian Black
          </button>
        </div>
      </div>
    </div>
    <div class="w-bscroll__progress" aria-hidden="true"><i data-bscroll-bar></i></div>
  </div>
</section>

{% schema %}
{
  "name": "Ürün · kutu açılışı",
  "settings": [
    { "type": "url", "id": "video_url", "label": "Video URL'si (isteğe bağlı)", "info": "Boşsa temadaki render kullanılır." },
    { "type": "text", "id": "video_asset", "default": "ws-box-reveal.mp4", "label": "Tema videosu" },
    { "type": "text", "id": "video_asset_mobile", "default": "ws-box-reveal-m.mp4", "label": "Tema videosu · telefon" },
    { "type": "text", "id": "poster_asset", "default": "ws-box-reveal-poster.jpg", "label": "Poster (ilk kare)" },
    { "type": "text", "id": "poster_end_asset", "default": "ws-box-reveal-end.jpg", "label": "Son kare (hareket azaltıldığında)" },
    { "type": "text", "id": "video_asset_black", "default": "ws-box-reveal-black.mp4", "label": "Obsidian Black videosu" },
    { "type": "text", "id": "video_asset_black_mobile", "default": "ws-box-reveal-black-m.mp4", "label": "Obsidian Black videosu · telefon" },
    { "type": "text", "id": "poster_asset_black", "default": "ws-box-reveal-black-poster.jpg", "label": "Obsidian Black poster" },
    { "type": "text", "id": "poster_end_asset_black", "default": "ws-box-reveal-black-end.jpg", "label": "Obsidian Black son kare" },
    { "type": "text", "id": "swatch_label", "default": "kutu rengi", "label": "Renk düğmeleri etiketi" },
    { "type": "text", "id": "alt", "default": "wango Origin kutusu açılıyor: kapak, iç kapak, insert ve kutu", "label": "Alternatif metin" },
    { "type": "text", "id": "eyebrow", "default": "kutu", "label": "Üst etiket" },
    { "type": "text", "id": "lead", "default": "kutuyu açtığın an", "label": "Küçük başlık" },
    { "type": "text", "id": "heading", "default": "sessizlik başlar.", "label": "Büyük başlık" },
    { "type": "range", "id": "scroll_length", "min": 120, "max": 400, "step": 10, "default": 280, "unit": "vh", "label": "Kaydırma uzunluğu" }
  ],
  "blocks": [
    { "type": "beat", "name": "Adım", "settings": [
      { "type": "text", "id": "kicker", "label": "Üst etiket" },
      { "type": "text", "id": "title", "label": "Başlık" },
      { "type": "textarea", "id": "body", "label": "Metin" },
      { "type": "range", "id": "start", "min": 0, "max": 100, "step": 1, "default": 30, "unit": "%", "label": "Başlangıç" },
      { "type": "range", "id": "end", "min": 0, "max": 100, "step": 1, "default": 55, "unit": "%", "label": "Bitiş" }
    ]}
  ],
  "presets": [{
    "name": "Ürün · kutu açılışı",
    "blocks": [
      { "type": "beat", "settings": { "kicker": "kapak", "title": "hoş geldin.", "body": "kapağın içinde seni kısa bir mektup karşılar. QR kod seni kullanım rehberine götürür.", "start": 23, "end": 55 } },
      { "type": "beat", "settings": { "kicker": "içinde", "title": "Origin ve dört boy uç.", "body": "M uç takılı gelir; S, L ve double yedekte bekler. hangisi kulağına oturuyorsa o.", "start": 53, "end": 83 } },
      { "type": "beat", "settings": { "kicker": "Origin", "title": "avucuna sığan bir sessizlik.", "body": "kutusunu çantana ya da karabinana tak, hep yanında olsun.", "start": 81, "end": 100 } }
    ]
  }]
}
{% endschema %}
