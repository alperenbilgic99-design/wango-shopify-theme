<section class="w-page">
  <div class="w-page__inner">
    {%- if section.settings.eyebrow != blank -%}<span class="w-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ page.title }}</h1>
    <div class="w-page__rte">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Sayfa",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Üst etiket" }
  ]
}
{% endschema %}
