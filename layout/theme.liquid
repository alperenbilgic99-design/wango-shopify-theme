<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0B0B0D">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {%- comment -%}
       Quicksand matches the rounded geometric `wango` wordmark on the product
       itself; Bricolage carries the few big display headlines; Hanken is body.
       Loaded from Google rather than packaged, so the exact same faces as the
       React build render — swapping in Shopify's font_picker would change the
       brand mark.
    {%- endcomment -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&display=swap">

    <link rel="stylesheet" href="{{ 'wango-base.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'wango-sections.css' | asset_url }}">

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Wango = window.Wango || {};
      window.Wango.moneyFormat = {{ shop.money_format | json }};
      window.Wango.locale = {{ request.locale.iso_code | json }};
    </script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-to-content visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'scrolltrigger.min.js' | asset_url }}" defer></script>
    <script src="{{ 'flip.min.js' | asset_url }}" defer></script>
    <script src="{{ 'splittext.min.js' | asset_url }}" defer></script>
    <script src="{{ 'customease.min.js' | asset_url }}" defer></script>
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-gl.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-case-3d.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-core.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-origin.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-scroll-fx.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-product-fx.js' | asset_url }}" defer></script>
    <script src="{{ 'wango-commerce.js' | asset_url }}" defer></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        window.Wango.setRoutes({
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }}
        });
      });
    </script>
  </body>
</html>
