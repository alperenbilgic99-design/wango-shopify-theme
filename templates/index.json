    "scenarios": {
      "type": "wango-scenarios",
      "blocks": {
        "c1": {
          "type": "scene",
          "settings": {
            "image_asset": "wb-brief-16.jpg",
            "number": "01",
            "tab": "Kalabalıkta",
            "title": "Gürültünün ortasında bir ton serinlik",
            "body": "Kalabalık senin sesini bastırmasın. wango dışarıyı kısar, seni bırakır."
          }
        },
        "c2": {
          "type": "scene",
          "settings": {
            "image_asset": "wb-brief-07.jpg",
            "number": "02",
            "tab": "Yolda",
            "title": "Sokakta, tıpkı bir küpe gibi",
            "body": "Örgüler, ince gümüşler ve kulakta wango. Aksesuar olarak, aksesuarla birlikte."
          }
        },
        "c3": {
          "type": "scene",
          "settings": {
            "image_asset": "wb-brief-09.jpg",
            "number": "03",
            "tab": "Kombinlerken",
            "title": "Gümüşün ve incinin yanında",
            "body": "Yüzük, halka, zincir — wango koleksiyonun bir parçası. Renkle, dokuyla uyumlanır."
          }
        },
        "c4": {
          "type": "scene",
          "settings": {
            "image_asset": "wb-brief-11.jpg",
            "number": "04",
            "tab": "Çantanda",
            "title": "Her gün yanında taşıdığın şey",
            "body": "Anahtarın, kartlığın, gözlüğünün yanında. Kaybolmayacak kadar kendine ait."
          }
        },
        "c5": {
          "type": "scene",
          "settings": {
            "image_asset": "wb-brief-17.jpg",
            "number": "05",
            "tab": "Masanda",
            "title": "Çalışırken, bir obje gibi",
            "body": "Eskiz defteri, seramik fincan, wango. İnsandan bağımsız, kendi başına güzel."
          }
        },
        "c6": {
          "type": "scene",
          "settings": {
            "image_asset": "wb-brief-13.jpg",
            "number": "06",
            "tab": "Gün biterken",
            "title": "Rafta, günün sonunda",
            "body": "Açık kutu, yerine oturmuş iki tıkaç. Yarın için hazır, bu gece için sessiz."
          }
        }
