<section class="w-page">
  <div class="w-page__inner">
    <span class="w-eyebrow">{{ 'general.search.title' | t }}</span>
    <h1>{{ 'general.search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="w-field" style="margin-top:2rem">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
    </form>

    {%- if search.performed -%}
      <p class="w-page__lede">{{ 'general.search.results' | t: count: search.results_count }}</p>
      <div class="w-coll">
        {%- for item in search.results -%}
          <a class="w-coll__card" href="{{ item.url }}">
            <div class="ptg-card__img">
              {%- if item.featured_media -%}
                <img src="{{ item.featured_media | image_url: width: 900 }}" alt="{{ item.title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
            <div class="ptg-card__body">
              <div class="ptg-card__row"><h3>{{ item.title }}</h3></div>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Arama" }{% endschema %}
