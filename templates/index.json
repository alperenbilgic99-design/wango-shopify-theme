    "transition": {
      "type": "wango-transition-story",
      "blocks": {
        "f1": {
          "type": "frame",
          "settings": {
            "image_asset": "wp-real-lilac-banner.jpg",
            "focus_x": 72,
            "focus_y": 58,
            "step": "Önce sessizlik",
            "kicker": "Kapalıyken",
            "title": "Avucuna sığan bir sessizlik.",
            "body": "Kapalıyken küçük, pürüzsüz bir taş gibi. Deri kayışıyla bileğine ya da çantana takılır, hep elinin altında kalır.",
            "chips": "Taşıma kutusu, Deri kayış",
            "card_pos": "top"
          }
        },
        "f2": {
          "type": "frame",
          "settings": {
            "image_asset": "wp-real-three-on-mint.jpg",
            "focus_x": 50,
            "focus_y": 100,
            "step": "Çoğaldığında",
            "kicker": "Yan yana",
            "title": "İki renk, aynı sade form.",
            "body": "Obsidian Black gece kadar koyu; Tropical Indigo ışığa göre açılıp koyulaşan bir mor. Hangisini seçersen seç, içi aynı.",
            "chips": "Obsidian Black, Tropical Indigo",
            "card_pos": "top"
          }
        },
        "f3": {
          "type": "frame",
          "settings": {
            "image_asset": "wp-real-claw-machine.jpg",
            "focus_x": 52,
            "focus_y": 30,
            "step": "Ve seçilir",
            "kicker": "Seçildiğinde",
            "title": "Ve biri senin olur.",
            "body": "Yığının içinden biri kalkıyor ve seninle geliyor. Uçlarını kulağına göre seçersin; hipoalerjenik silikon, yıkanabilir.",
            "chips": "4 boy uç: S · M · L · Double, Yıkanabilir"
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3"
      ],
      "settings": {
        "body": "Üç kare, tek bir kutunun hikâyesi."
      }
    },
    "moments": {
      "type": "wango-moment-cards",
      "blocks": {
        "m1": {
          "type": "moment",
          "settings": {
            "image_asset": "wp-real-canvas-gymbag.jpg",
            "title": "SABAH",
            "meta": "Kahve, sessizlik, ilk sayfa",
            "body": "Ev uyanmadan önceki yarım saat. Sokaktan gelen uğultu geri çekilir; kahvenin sesi ve sayfanın hışırtısı kalır. Günün ilk odağı senin."
          }
        },
        "m2": {
          "type": "moment",
          "settings": {
            "image_asset": "wp-real-tray-flatlay.jpg",
            "title": "YOLDA",
            "meta": "Şehrin gürültüsü kısılır",
            "body": "Metro, otobüs, kalabalık bir cadde. wango uğultunun sertliğini alır; anonsu da yanındakinin sesini de duymaya devam edersin."
          }
        },
        "m3": {
          "type": "moment",
          "settings": {
            "image_asset": "wp-real-three-on-mint.jpg",
            "title": "ODAK",
            "meta": "Dünya beklesin, sen dinle",
            "body": "Açık ofis, kafe, kütüphane. Yan masadaki sohbet uzaklaşır, telefonun çaldığında yine duyarsın. Müzik açmadan odaklanmanın bir yolu."
          }
        },
        "m4": {
          "type": "moment",
          "settings": {
            "image_asset": "wp-real-leather-bag.jpg",
            "title": "AKŞAM",
            "meta": "Kalabalıkta kendi ritmin",
            "body": "Konser, bar, kalabalık bir masa. Müzik yerinde kalır, yalnızca şiddeti azalır; arkadaşının söylediğini kaçırmazsın."
          }
        },
        "m5": {
          "type": "moment",
          "settings": {
            "image_asset": "wp-real-claw-machine.jpg",
            "title": "GECE",
            "meta": "Gün biter, sessizlik kalır",
            "body": "Geç biten bir etkinlik, eve dönüş yolu. Kutusunu deri kayışından çantana tak; gün bittiğinde de yanında."
          }
        }
      },
      "block_order": [
        "m1",
        "m2",
        "m3",
        "m4",
        "m5"
      ],
      "settings": {}
    },
