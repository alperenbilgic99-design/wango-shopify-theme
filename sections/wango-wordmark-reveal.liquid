{%- comment -%}
  A live, mouse-scrubbable video revealed entirely through the shape of the
  "wango" wordmark — ported from wordmark-story-reveal.tsx. ONE mechanic, no
  layer-swap crossfade: the mask keeps zooming in on a guaranteed-solid point
  inside a letter stroke until that letter's own fill covers the frame.

  The video never autoplays: horizontal mouse movement scrubs currentTime,
  and the same pointer drives a soft water-ripple across the surface.

  The clip lives in Content → Files (Shopify's assets folder rejects video),
  and its URL is a theme setting. With no URL set, the poster shows instead.
{%- endcomment -%}

{%- liquid
  if section.settings.poster != blank
    assign poster_src = section.settings.poster | image_url: width: 1600
  else
    assign poster_src = 'ws-hero-scrub-poster.jpg' | asset_url
  endif
  if section.settings.poster_portrait != blank
    assign poster_portrait = section.settings.poster_portrait | image_url: width: 900
  else
    assign poster_portrait = 'ws-hero-scrub-poster-m.jpg' | asset_url
  endif
-%}

<div class="w-wordmark-outer" data-wordmark data-video="{{ section.settings.video_url }}" data-video-mobile="{{ section.settings.video_url_mobile }}">
  <div class="w-wordmark-sticky" data-wordmark-sticky>
    <picture>
      <source media="(max-aspect-ratio: 1/1)" srcset="{{ poster_portrait }}">
      <img class="w-wordmark-poster" data-wordmark-poster src="{{ poster_src }}" alt="">
    </picture>
    <div class="w-wordmark-host" data-wordmark-host></div>
    <div class="w-wordmark-scrim" data-wordmark-scrim aria-hidden="true"></div>
    <p class="w-wordmark-hint" data-wordmark-hint aria-hidden="true">{{ section.settings.touch_hint }}</p>

    <div class="w-wordmark-copy" data-wordmark-copy>
      <span class="w-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.body }}</p>
      <div class="w-wordmark-actions">
        {%- if section.settings.cta_url != blank -%}
          <a class="w-btn w-btn--solid" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        <button type="button" class="w-btn w-btn--ghost" data-wordmark-read>{{ section.settings.read_label }}</button>
      </div>
    </div>
  </div>
</div>

<div class="w-wordmark-continue" data-wordmark-continue>
  <div>
    <span class="w-eyebrow" style="letter-spacing:.28em">{{ section.settings.story_eyebrow }}</span>
    <h2>{{ section.settings.story_heading }}</h2>
    <p>{{ section.settings.story_body }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Origin · kelime maskesi",
  "settings": [
    { "type": "url", "id": "video_url", "label": "Video URL'si", "info": "Videoyu Ayarlar → Dosyalar'a yükleyip CDN bağlantısını buraya yapıştır. Boşsa yalnızca poster görünür." },
    { "type": "url", "id": "video_url_mobile", "label": "Video URL'si · telefon", "info": "Kafanın etrafından dikey kırpılmış, hafif sürüm (hero-scrub-mobile.mp4). Boşsa telefonda yalnızca poster görünür." },
    { "type": "image_picker", "id": "poster", "label": "Poster görseli" },
    { "type": "image_picker", "id": "poster_portrait", "label": "Poster görseli · dikey (telefon)", "info": "Boşsa temanın dikey posteri kullanılır." },
    { "type": "text", "id": "touch_hint", "default": "Kafayı çevirmek için sağa sola kaydır", "label": "Dokunmatik ipucu" },
    { "type": "text", "id": "eyebrow", "default": "wango · an", "label": "Üst etiket" },
    { "type": "text", "id": "heading", "default": "Origini hisset.", "label": "Başlık" },
    { "type": "textarea", "id": "body", "default": "Gözden kaçmayacak kadar ince, hissedilmeyecek kadar hafif. Bildirim sesi yok, göze çarpan bir cihaz yok — sadece sana ait, günün arka planında sessizce duran bir an.", "label": "Metin" },
    { "type": "text", "id": "cta_label", "default": "Setleri gör", "label": "Buton" },
    { "type": "url", "id": "cta_url", "label": "Buton bağlantısı" },
    { "type": "text", "id": "read_label", "default": "Hikâyeyi oku", "label": "İkinci buton" },
    { "type": "header", "content": "Devam eden hikâye" },
    { "type": "text", "id": "story_eyebrow", "default": "wango · hikâye", "label": "Üst etiket" },
    { "type": "textarea", "id": "story_heading", "default": "Her günün kendi ritmi var. wango sadece onu duyman için kenara çekilir.", "label": "Başlık" },
    { "type": "textarea", "id": "story_body", "default": "Ne bir bildirim sesi, ne göze çarpan bir cihaz. Sadece sen ve etrafındaki sessizlik — geri kalanı zaten oradaydı.", "label": "Metin" }
  ],
  "presets": [{ "name": "Origin · kelime maskesi" }]
}
{% endschema %}
