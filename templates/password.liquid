<h1 style="margin-top:2rem">{{ 'general.password_page.title' | t }}</h1>
<p class="w-page__lede" style="margin-inline:auto">{{ shop.password_message }}</p>
{%- form 'storefront_password' -%}
  <label class="w-field" style="max-width:360px;margin-inline:auto">
    <span class="visually-hidden">{{ 'general.password_page.password' | t }}</span>
    <input type="password" name="password" autocomplete="current-password">
  </label>
  {%- if form.errors -%}<p class="w-formerror">{{ form.errors.messages['form'] }}</p>{%- endif -%}
  <button type="submit" class="w-btn w-btn--solid" style="margin-top:1.25rem">{{ 'general.password_page.enter' | t }}</button>
{%- endform -%}
