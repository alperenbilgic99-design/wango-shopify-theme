    "story": {
      "type": "wango-short-story",
      "blocks": {
        "b1": {
          "type": "row",
          "settings": {
            "image_asset": "wb-brief-01.jpg",
            "eyebrow": "Neden mat",
            "title": "Parlamayan bir yüzey, dikkat çekmeyen bir nesne.",
            "body": "Sedef periwinkle, ışığı yansıtmak yerine içine alır. Kulağında olduğunu sen bilirsin; karşındaki fark etmez. Mat bitiş bir tercih, bir eksik değil."
          }
        },
        "b2": {
          "type": "row",
          "settings": {
            "image_asset": "wb-brief-08.jpg",
            "eyebrow": "Nasıl durur",
            "title": "Konkaya oturur, kanala yerleşir, orada kalır.",
            "body": "İki loblu gövde kulağın kendi çukuruna gömülür. Dışarı fırlamaz, koşarken düşmez, saatlerce takılı kalınca acıtmaz. Üç boy silikon uçla kendi kulağına ayarlarsın."
          }
        },
        "b3": {
          "type": "row",
          "settings": {
            "image_asset": "wb-brief-19.jpg",
            "eyebrow": "Yanında",
            "title": "Çantanda kaybolmayacak kadar kendine ait.",
            "body": "Kırk dört milimetrelik kutu, anahtarının ve kartlığının yanında bir aksesuar gibi durur. Bileklik askısı çanta sapına da geçer — kolye değil, taşınacak bir nesne."
          }
        }
      },
