{%- comment -%}
  Promise ticker: a slim band of short shop promises (shipping, dispatch time,
  first-order offer) that runs sideways. On wide screens it glides on its own
  and stops under the pointer; on phones it moves with the page scroll, like
  every other animation there (wango-extras.js, [data-ticker]).

  The items are written twice in a row so the loop has no seam; the second
  copy is hidden from screen readers. Only state promises the shop really
  keeps: these lines are what a buyer holds us to.
{%- endcomment -%}

{%- capture items -%}
  {%- for block in section.blocks -%}
    <li class="w-ticker__item" {{ block.shopify_attributes }}>
      {%- case block.settings.icon -%}
        {%- when 'truck' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
        {%- when 'clock' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
        {%- when 'mail' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
        {%- when 'lock' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
        {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5 14 10l6.5 2-6.5 2-2 6.5-2-6.5-6.5-2L10 10z"/></svg>
      {%- endcase -%}
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
      {%- else -%}
        <span>{{ block.settings.text }}</span>
      {%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- if section.blocks.size > 0 -%}
  <section class="w-ticker w-ticker--{{ section.settings.tone }} w-ticker--on-{{ section.settings.ground }}" data-ticker
           style="--ticker-speed: {{ section.settings.speed }}s">
    <div class="w-ticker__band">
      <div class="w-ticker__track" data-ticker-track>
        <ul class="w-ticker__run">{{ items }}{{ items }}</ul>
        <ul class="w-ticker__run" aria-hidden="true">{{ items }}{{ items }}</ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Kayan şerit",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "tone", "label": "Renk", "default": "purple",
      "options": [ { "value": "purple", "label": "Mor" }, { "value": "ink", "label": "Siyah" } ] },
    { "type": "select", "id": "ground", "label": "Arkadaki zemin", "default": "paper", "info": "Şeridin çevresindeki bölümlerin rengi; eğik şeridin köşelerinde görünür.",
      "options": [ { "value": "paper", "label": "Açık" }, { "value": "black", "label": "Siyah" } ] },
    { "type": "range", "id": "speed", "min": 20, "max": 80, "step": 5, "unit": "sn", "default": 40, "label": "Bir tur süresi (masaüstü)" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Bilgi",
      "settings": [
        { "type": "text", "id": "text", "label": "Metin" },
        { "type": "select", "id": "icon", "label": "İkon", "default": "spark",
          "options": [
            { "value": "truck", "label": "Kargo" }, { "value": "clock", "label": "Saat" },
            { "value": "mail", "label": "E-posta" }, { "value": "lock", "label": "Kilit" },
            { "value": "spark", "label": "Yıldız" }
          ] },
        { "type": "url", "id": "link", "label": "Bağlantı (isteğe bağlı)" }
      ]
    }
  ],
  "presets": [{
    "name": "Kayan şerit",
    "blocks": [
      { "type": "item", "settings": { "text": "Ücretsiz kargo", "icon": "truck" } },
      { "type": "item", "settings": { "text": "2 iş günü içinde kargoda", "icon": "clock" } },
      { "type": "item", "settings": { "text": "Bültene katıl, ilk siparişine %10 indirim", "icon": "mail" } }
    ]
  }]
}
{% endschema %}
